# Copie este arquivo para .env e preencha com valores reais/gerados.
#   cp .env.example .env
#
# NUNCA versionar o .env de verdade — ele contém credenciais e chaves
# secretas. Só este .env.example (sem segredos) deve ir para o git.

# ---------------------------------------------------------------------------
# Identidade / permissões de arquivo
# ---------------------------------------------------------------------------
# UID do seu usuário no host (rode `id -u`), para os volumes montados
# (dags/logs/plugins/config) não ficarem com dono "root".
AIRFLOW_UID=1000

# ---------------------------------------------------------------------------
# Imagem
# ---------------------------------------------------------------------------
AIRFLOW_IMAGE_NAME=app-airflow3:3.3.1

# ---------------------------------------------------------------------------
# PostgreSQL (banco de metadados do Airflow)
# ---------------------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=airflow

# ---------------------------------------------------------------------------
# Chaves e segredos do Airflow — gere valores únicos por ambiente, nunca
# reutilize entre dev/homologação/produção.
#
#   Fernet key (criptografa credenciais de Connections/Variables no banco):
#     python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
#   JWT secret (assina tokens da API interna de execução):
#     openssl rand -hex 32
#
#   API/UI secret key (sessões, CSRF e assinatura de tokens da API):
#     openssl rand -hex 30
# ---------------------------------------------------------------------------
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API__SECRET_KEY=

# Exemplos de DAGs prontas do Airflow — mantenha "false" em ambiente
# institucional para não poluir a UI; use "true" só para explorar/estudar.
AIRFLOW__CORE__LOAD_EXAMPLES=false

# ---------------------------------------------------------------------------
# Usuário administrador inicial (criado apenas na primeira inicialização,
# via airflow-init). Troque a senha depois do primeiro login.
# ---------------------------------------------------------------------------
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=troque-esta-senha
_AIRFLOW_WWW_USER_FIRSTNAME=Admin
_AIRFLOW_WWW_USER_LASTNAME=Institucional
_AIRFLOW_WWW_USER_EMAIL=admin@example.org

# ---------------------------------------------------------------------------
# Postgres do app_tcg-pokemon (lido pela DAG export_tcg_pokemon_to_s3)
# Valores default abaixo batem com repos/app_tcg-pokemon/docker-compose.yml.
# ---------------------------------------------------------------------------
TCG_POSTGRES_HOST=host.docker.internal
TCG_POSTGRES_PORT=25432
TCG_POSTGRES_DB=tcg_db
TCG_POSTGRES_USER=tcg_user
TCG_POSTGRES_PASSWORD=tcg_pass

# ---------------------------------------------------------------------------
# Postgres local generico (toolData_postgre) - lido pela DAG DAG_historica_bc_94ate25
# Valores default abaixo batem com repos/toolData_postgre/docker-compose.yml.
# ---------------------------------------------------------------------------
LOCAL_POSTGRES_HOST=host.docker.internal
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DB=postgres
LOCAL_POSTGRES_USER=postgres
LOCAL_POSTGRES_PASSWORD=troque-esta-senha
